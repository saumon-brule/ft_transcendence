datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

enum Visibility {
  PUBLIC
  PRIVATE
}

model Provider {
  id              Int        @id @default(1)
  uuid            String     @unique
  visibility      Visibility @default(PRIVATE)
  ownerUuid       String     @unique
  defaultRoleUuid String?    @unique

  owner       Member @relation(fields: [ownerUuid], references: [uuid], onDelete: Restrict)
  defaultRole Role?  @relation(fields: [defaultRoleUuid], references: [uuid], onDelete: SetNull)
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model AccessRequest {
  id            Int           @id @default(autoincrement())
  uuid          String        @unique @default(uuid())
  userUuid      String
  status        RequestStatus @default(PENDING)
  decidedByUuid String?
  decidedAt     DateTime?
  updatedAt     DateTime      @updatedAt
  createdAt     DateTime      @default(now())

  decidedBy Member? @relation(fields: [decidedByUuid], references: [uuid], onDelete: SetNull)

  @@index([decidedByUuid])
  @@index([status, createdAt])
  @@index([userUuid])
  @@index([uuid])
}

model Member {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique
  revokedAt     DateTime?
  revokedByUuid String?
  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())

  isOwner               Provider?
  revokedBy             Member?         @relation("RevokedBy", fields: [revokedByUuid], references: [uuid], onDelete: SetNull)
  roles                 MemberRole[]
  rolesCreated          Role[]
  musicAdded            Music[]
  artistsAdded          Artist[]
  albumsAdded           Album[]
  accessRequestsManaged AccessRequest[]
  revokedMembers        Member[]        @relation("RevokedBy")

  @@index([revokedByUuid])
  @@index([uuid])
}

model MemberRole {
  id         Int      @id @default(autoincrement())
  memberUuid String
  roleUuid   String
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  member Member @relation(fields: [memberUuid], references: [uuid], onDelete: Cascade)
  role   Role   @relation(fields: [roleUuid], references: [uuid], onDelete: Cascade)

  @@unique([memberUuid, roleUuid])
  @@index([roleUuid, memberUuid])
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  uuid        String   @unique @default(uuid())
  addedByUuid String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  isDefault   Provider?
  addedBy     Member?          @relation(fields: [addedByUuid], references: [uuid], onDelete: SetNull)
  permissions RolePermission[]
  members     MemberRole[]

  @@index([addedByUuid])
}

enum Permission {
  MANAGE_CATALOG
  MANAGE_MEMBERS
  MANAGE_ROLES
}

model RolePermission {
  id         Int        @id @default(autoincrement())
  roleUuid   String
  permission Permission
  updatedAt  DateTime   @updatedAt
  createdAt  DateTime   @default(now())

  role Role @relation(fields: [roleUuid], references: [uuid], onDelete: Cascade)

  @@unique([roleUuid, permission])
  @@index([permission, roleUuid])
}

model Music {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(uuid())
  path        String
  coverPath   String?
  name        String
  duration    Int
  albumUuid   String?
  publishedAt DateTime?
  addedByUuid String?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  addedBy Member?       @relation(fields: [addedByUuid], references: [uuid], onDelete: SetNull)
  album   Album?        @relation(fields: [albumUuid], references: [uuid], onDelete: SetNull)
  artists MusicArtist[]

  @@index([addedByUuid])
  @@index([albumUuid])
  @@index([uuid])
}

model MusicArtist {
  id         Int      @id @default(autoincrement())
  musicUuid  String
  artistUuid String
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  music  Music  @relation(fields: [musicUuid], references: [uuid], onDelete: Cascade)
  artist Artist @relation(fields: [artistUuid], references: [uuid], onDelete: Cascade)

  @@unique([musicUuid, artistUuid])
  @@index([artistUuid, musicUuid])
}

model Artist {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  name        String
  coverPath   String?
  biography   String?
  addedByUuid String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  addedBy Member?       @relation(fields: [addedByUuid], references: [uuid], onDelete: SetNull)
  music   MusicArtist[]
  albums  AlbumArtist[]

  @@index([addedByUuid])
  @@index([uuid])
}

model AlbumArtist {
  id         Int      @id @default(autoincrement())
  albumUuid  String
  artistUuid String
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  album  Album  @relation(fields: [albumUuid], references: [uuid], onDelete: Cascade)
  artist Artist @relation(fields: [artistUuid], references: [uuid], onDelete: Cascade)

  @@unique([albumUuid, artistUuid])
  @@index([artistUuid, albumUuid])
}

model Album {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(uuid())
  name        String
  coverPath   String?
  publishedAt DateTime?
  addedByUuid String?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  addedBy Member?       @relation(fields: [addedByUuid], references: [uuid], onDelete: SetNull)
  musics  Music[]
  artists AlbumArtist[]

  @@index([addedByUuid])
  @@index([uuid])
}
