datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/client"
  moduleFormat = "cjs"
}

enum Role {
  READ
  WRITE
  ADMIN
  OWNER
}

model Permissions {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique
  role      Role     @default(READ)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Music {
  id          Int       @id @default(autoincrement())
  albumId     Int?
  uuid        String    @unique
  path        String
  coverPath   String?
  name        String
  duration    Int
  publishedAt DateTime?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  album   Album?        @relation(fields: [albumId], references: [id], onDelete: SetNull)
  artists MusicArtist[]
}

model MusicArtist {
  id        Int      @id @default(autoincrement())
  musicId   Int
  artistId  Int
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  music  Music  @relation(fields: [musicId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
}

model Artist {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique
  name      String
  coverPath String?
  biography String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  music  MusicArtist[]
  albums AlbumArtist[]
}

model AlbumArtist {
  id        Int      @id @default(autoincrement())
  albumId   Int
  artistId  Int
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  album  Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
}

model Album {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique
  name        String
  coverPath   String?
  publishedAt DateTime?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  musics  Music[]
  artists AlbumArtist[]
}
