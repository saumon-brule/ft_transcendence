# Development only (pnpm run dev:provider). Production settings are in .env.provider.example at the root.

# The development back directly (the /api prefix only exists behind the production nginx)
FLEX_SERVER_URL="http://localhost:3001"
FLEX_API_KEY="your_flex_api_key"
DATABASE_URL="postgresql://dev:dev@localhost:5432/flex-provider"

NODE_ENV="dev"
PORT=3002
MEDIA_DIR="media"

# Mock catalog seeded by "pnpm run dev:provider" (mock/discography.v2.json = "1", mock/discography.v3.json = "2")
# MOCK_DISCOGRAPHY="1"
