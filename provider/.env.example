# Development and production

FLEX_SERVER_URL="https://host.docker.internal:3000/api"
HOST_GATEWAY="10.14.3.4"

# Development

FLEX_API_KEY="your_flex_api_key"
DATABASE_URL="postgresql://dev:dev@localhost:5432/flex-provider"

NODE_ENV="dev"
PORT=3443
MEDIA_DIR="media"

# Production

PROVIDER_URL=https://localhost:3443

PROVIDER_PORT=3443
PROVIDER_HTTP_PORT=3080

POSTGRES_USER=flex
POSTGRES_DB=flex-provider

# dev only, seeds mock/discography.v2.json ("1") or mock/discography.v3.json ("2")
