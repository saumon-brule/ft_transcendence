generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth & Members ───────────────────────────────────────────────────────────

model Member {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  password       String?
  login          String?   @unique
  displayName    String?   @map("display_name")
  internalNote   String?   @map("internal_note")
  joinDate       DateTime? @map("join_date")
  emailValidated Boolean   @map("email_validated") @default(false)
  updatedAt      DateTime? @updatedAt @map("updated_at")
  createdAt      DateTime? @default(now()) @map("created_at")

  memberRoles            MemberRole[]
  sessions               Session[]
  tokens                 Token[]

  @@map("members")
}

model Session {
  id        Int      @id @default(autoincrement())
  memberId  Int      @map("member_id")
  jti       String   @map("refresh_token")
  userAgent String?  @map("user_agent")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  member Member @relation(fields: [memberId], references: [id])

  @@unique([memberId, jti])
  @@map("sessions")
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  EMAIL_RESET
  PASSWORD_RESET
  STATE_42AUTH
  STATE_42LINK
}

model Token {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  purpose   TokenPurpose
  memberId  Int?      @map("member_id")
  data      Json?
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")

  member    Member?   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("tokens")
}

// ─── Roles & Permissions ──────────────────────────────────────────────────────

model Role {
  id           Int     @id @default(autoincrement())
  name         String  @unique
  superRole    Boolean @default(false) @map("super_role")
  defaultRole  Boolean @default(false) @map("default_role")
  displayColor String? @map("display_color")

  rolePermissions RolePermission[]
  memberRoles     MemberRole[]

  @@map("roles")
}

model RolePermission {
  id         Int    @id @default(autoincrement())
  roleId     Int    @map("role_id")
  permission String

  roleRef Role @relation(fields: [roleId], references: [id])

	@@unique([roleId, permission])
  @@map("role_permissions")
}

model MemberRole {
  id       Int  @id @default(autoincrement())
  memberId Int  @map("member_id")
  roleId   Int  @map("role_id")

  memberRef Member @relation(fields: [memberId], references: [id])
  roleRef   Role   @relation(fields: [roleId], references: [id])

	@@unique([memberId, roleId])
  @@map("member_roles")
}

// ─── Settings ─────────────────────────────────────────────────────────────────

model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_config")
}
