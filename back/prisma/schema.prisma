generator client {
    provider     = "prisma-client"
    output       = "../src/generated/prisma"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
}

// ─── Auth & Users ───────────────────────────────────────────────────────────

model User {
    id                     Int       @id @default(autoincrement())
    uuid                   String    @unique @default(uuid())
    email                  String    @unique
    password               String?
    username               String
    emailValidated         Boolean   @default(false)
    intraId                Int?      @unique
    language               String?   @default("en")
    currentlyListeningUUID String?
    listeningUntil         DateTime?
    listeningPrivate       Boolean   @default(false)
    avatarUpdatedAt        DateTime  @default(now())
    updatedAt              DateTime? @updatedAt
    createdAt              DateTime? @default(now())

    userRoles          UserRole[]
    sessions           Session[]
    tokens             Token[]
    ownedProviders     Provider[]
    providers          ProviderUser[]
    providerAccessRequests ProviderAccessRequest[]
    playlists          UserPlaylist[]
    ownedPlaylists     Playlist[]
    currentlyListening Music?          @relation(fields: [currentlyListeningUUID], references: [uuid], onDelete: SetNull)
    friendsRequests    FriendRequest[] @relation("Requester")
    friendsReceive     FriendRequest[] @relation("Receiver")
}

enum FriendStatus {
    ACCEPTED
    DENIED
    PENDING
}

model FriendRequest {
    id         Int          @id @default(autoincrement())
    userUUID   String       @map("user_uuid")
    friendUUID String       @map("friend_uuid")
    status     FriendStatus @map("status")

    user   User @relation("Requester", fields: [userUUID], references: [uuid], onDelete: Cascade)
    friend User @relation("Receiver", fields: [friendUUID], references: [uuid], onDelete: Cascade)

    @@unique([userUUID, friendUUID])
}

model Session {
    id        Int      @id @default(autoincrement())
    userUUID  String
    jti       String
    userAgent String?
    ipAddress String?
    createdAt DateTime @default(now())
    expiresAt DateTime

    user User @relation(fields: [userUUID], references: [uuid], onDelete: Cascade)

    @@unique([userUUID, jti])
}

enum TokenPurpose {
    EMAIL_VERIFICATION
    EMAIL_RESET
    PASSWORD_RESET
    STATE_42AUTH
    STATE_42LINK
}

model Token {
    id        Int          @id @default(autoincrement())
    token     String       @unique
    purpose   TokenPurpose
    userUUID  String?
    data      Json?
    expiresAt DateTime
    createdAt DateTime     @default(now())

    user User? @relation(fields: [userUUID], references: [uuid], onDelete: Cascade)
}

// ─── Roles & Permissions ──────────────────────────────────────────────────────

model Role {
    id           Int     @id @default(autoincrement())
    name         String  @unique
    superRole    Boolean @default(false)
    defaultRole  Boolean @default(false)
    displayColor String?

    rolePermissions RolePermission[]
    userRoles       UserRole[]
}

model RolePermission {
    id         Int    @id @default(autoincrement())
    roleId     Int
    permission String

    roleRef Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

    @@unique([roleId, permission])
}

model UserRole {
    id       Int    @id @default(autoincrement())
    userUUID String
    roleId   Int

    userRef User @relation(fields: [userUUID], references: [uuid], onDelete: Cascade)
    roleRef Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

    @@unique([userUUID, roleId])
}

// ─── Settings ─────────────────────────────────────────────────────────────────

model AppConfig {
    key       String   @id
    value     String
    updatedAt DateTime @updatedAt
}

model Provider {
    id            Int      @id @default(autoincrement())
    uuid          String   @unique @default(uuid())
    name          String   @unique
    address       String   @unique
    ownerUUID     String
    hashedKey     String   @unique
    publicDisplay Boolean  @default(true)
    //note      Int?
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    users ProviderUser[]
    accessRequests ProviderAccessRequest[]
    owner User           @relation(fields: [ownerUUID], references: [uuid], onDelete: Cascade)
}

model ProviderUser {
    id            Int      @id @default(autoincrement())
    providerUUID  String
    userUUID      String
    publicDisplay Boolean  @default(true)
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    provider Provider @relation(fields: [providerUUID], references: [uuid], onDelete: Cascade)
    user     User     @relation(fields: [userUUID], references: [uuid], onDelete: Cascade)

    @@unique([providerUUID, userUUID])
}

enum AccessRequestStatus {
    PENDING
    APPROVED
    REJECTED
}

model ProviderAccessRequest {
    id           Int                 @id @default(autoincrement())
    providerUUID String
    userUUID     String
    status       AccessRequestStatus @default(PENDING)
    decidedAt    DateTime?
    createdAt    DateTime            @default(now())
    updatedAt    DateTime            @updatedAt

    provider Provider @relation(fields: [providerUUID], references: [uuid], onDelete: Cascade)
    user     User     @relation(fields: [userUUID], references: [uuid], onDelete: Cascade)

    @@unique([providerUUID, userUUID])
    @@index([userUUID])
}

model Playlist {
    id        Int      @id @default(autoincrement())
    uuid      String   @unique @default(uuid())
    name      String
    ownerUUID String
    private   Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    userPlaylists UserPlaylist[]
    musics        PlaylistMusic[]
    owner         User            @relation(fields: [ownerUUID], references: [uuid], onDelete: Cascade)
}

model UserPlaylist {
    id           Int      @id @default(autoincrement())
    userUUID     String
    playlistUUID String
    // role ? (contributor, viewer)
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    user     User     @relation(fields: [userUUID], references: [uuid], onDelete: Cascade)
    playlist Playlist @relation(fields: [playlistUUID], references: [uuid], onDelete: Cascade)

    @@unique([userUUID, playlistUUID])
}

model PlaylistMusic {
    id           Int      @id @default(autoincrement())
    playlistUUID String
    musicUUID    String
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    playlist Playlist @relation(fields: [playlistUUID], references: [uuid], onDelete: Cascade)
    music    Music    @relation(fields: [musicUUID], references: [uuid], onDelete: Cascade)
}

model Music {
    id        Int      @id @default(autoincrement())
    uuid      String   @unique @default(uuid())
    title     String
    artist    String
    duration  Int
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    playlistMusics          PlaylistMusic[]
    currentlyListeningUsers User[]
}
