{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		// General
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"target": "ESNext",

		// Modules
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,

		// Type Checking & Safety
		"types": ["vite/client"],
		"baseUrl": ".",
		"paths": {
			"~/*": ["src/*"],
		},
	},
}
