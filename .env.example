# Production settings of the server stack (docker compose reads this file as .env).
# Created by "make secrets-server". Providers have their own file, see .env.provider.example.

# Public address of the site: https://<FRONT_HOST>:<FRONT_PORT> (without the port when it is 443).
# It is the address registered at 42: https://<FRONT_HOST>:<FRONT_PORT>/auth/42/auth-callback
FRONT_HOST=localhost
FRONT_PORT=443
FRONT_HTTP_PORT=80

# Only for the standalone mode: local HTTP port.
# FRONT_UPSTREAM_PORT=8081

POSTGRES_USER=flex
POSTGRES_DB=flex

VITE_API_URL=/api
VITE_DEFAULT_LANG=en

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=

API42_CLIENT_UID=

TRUST_PROXY=1
