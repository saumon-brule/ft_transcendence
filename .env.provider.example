# Production settings of ONE provider (several can run on the same machine).
# Created by "make secrets-provider NAME=<name>" as .env.provider-<name>, then used by "make provider NAME=<name>".
# Each provider needs its own ports.

# Address of the Flex server API, reachable from the container. It ends with /api when it targets the Docker front
# (https://host.docker.internal:<FRONT_PORT>/api for a server on the same machine).
FLEX_SERVER_URL=https://host.docker.internal:443/api
# HOST_GATEWAY=10.14.3.4

# Public address of the provider, the one browsers use and that you register on the server:
# https://<PROVIDER_HOST>:<PROVIDER_PORT>
PROVIDER_HOST=localhost
PROVIDER_PORT=443
PROVIDER_HTTP_PORT=80

# Only for the standalone mode: local HTTP port.
# PROVIDER_UPSTREAM_PORT=4081

POSTGRES_USER=flex
POSTGRES_DB=flex-provider
